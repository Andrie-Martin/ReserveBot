<%- include('partials/header') %>

<section class="card">
  <h1>Welcome, <%= user.name %></h1>
  <p class="muted">
    <%= user.departmentName %><% if (user.section) { %> · <%= user.section %><% } %>
  </p>
  <p><%= intro %></p>

  <% if (stat) { %>
    <p class="stat"><strong><%= stat.value %></strong> <%= stat.label %></p>
  <% } %>

  <% if (classes) { %>
    <h2>Your block's classes this semester</h2>
    <% if (classes.length === 0) { %>
      <p class="muted">No classes found for your block this semester.</p>
    <% } else { %>
      <table>
        <thead>
          <tr><th>Day</th><th>Time</th><th>Room</th><th>Course</th><th>Instructor</th></tr>
        </thead>
        <tbody>
          <% for (const c of classes) { %>
            <tr>
              <td><%= c.DayOfWeek %></td>
              <td><%= c.StartTime %> – <%= c.EndTime %></td>
              <td><%= c.Room %></td>
              <td><%= c.Code %><% if (c.Title) { %> · <%= c.Title %><% } %></td>
              <td><%= c.Instructor || '' %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  <% } %>

  <h2>Coming in the next phases</h2>
  <ul>
    <% for (const item of comingNext) { %>
      <li><%= item %></li>
    <% } %>
  </ul>
</section>

<%- include('partials/footer') %>
